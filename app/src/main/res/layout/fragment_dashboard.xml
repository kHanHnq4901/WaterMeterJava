<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    tools:context="com.emic.watermeter.ui.dashboard.DashboardFragment">
    <!-- LinearLayout chứa thông tin STT, Serial, Dàn, Loại, Tải, Sai số -->
    <LinearLayout
        android:id="@+id/infoLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="1"
        android:background="@drawable/border_info">

        <!-- Cột 1: STT và Serial -->
        <LinearLayout
            android:id="@+id/column1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textSTT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STT:"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginBottom="1dp"/>

            <TextView
                android:id="@+id/textSerial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Serial:"
                android:textSize="12sp"
                android:textColor="@color/black"/>
        </LinearLayout>

        <!-- Cột 2: Dàn và Loại -->
        <LinearLayout
            android:id="@+id/column2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textDan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dàn:"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginBottom="1dp"/>

            <TextView
                android:id="@+id/textLoai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loại:"
                android:textSize="12sp"
                android:textColor="@color/black"/>
        </LinearLayout>

        <!-- Cột 3: Tải và Sai số -->
        <LinearLayout
            android:id="@+id/column3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tải:"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginBottom="1dp"/>

            <TextView
                android:id="@+id/textSaiSo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="V chuẩn:"
                android:textSize="12sp"
                android:textColor="@color/black"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ImageView nằm dưới LinearLayout -->
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:background="@color/primary"
        app:layout_constraintTop_toBottomOf="@+id/infoLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="1"
        android:elevation="4dp"
        tools:src="@tools:sample/avatars" />


    <!-- Các TextView trên ImageView -->

    <!-- Nút x1, x2, x5, x10 -->
    <LinearLayout
        android:id="@+id/linearLayoutButtons"
        android:layout_width="149dp"
        android:layout_height="43dp"
        android:elevation="4dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/imageView2"
        app:layout_constraintEnd_toEndOf="@id/imageView2"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@id/imageView2">

        <Button
            android:id="@+id/buttonX1"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="@drawable/round_button"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="6dp" />

        <Button
            android:id="@+id/buttonX2"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="@drawable/round_button"
            android:text="2"
            android:textColor="@color/white"
            android:textSize="6dp" />

        <Button
            android:id="@+id/buttonX5"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="@drawable/round_button"
            android:text="5"
            android:textColor="@color/white"
            android:textSize="6dp" />

        <Button
            android:id="@+id/buttonX10"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/round_button"
            android:text="10"
            android:textColor="@color/white"
            android:textSize="5dp" />
    </LinearLayout>

    <!-- LinearLayout chứa các Button chính -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="0dp"
        android:elevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/imageView2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="1">

        <!-- Nút "Bắt đầu" -->
        <Button
            android:id="@+id/buttonBatDau"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Bắt đầu"
            android:backgroundTint="@color/green"
            android:textColor="@color/white"
            android:elevation="2dp" />

        <!-- Nút "Kết thúc" -->
        <Button
            android:id="@+id/buttonKetThuc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Kết thúc"
            android:backgroundTint="@color/red"
            android:textColor="@color/white"
            android:elevation="2dp"
            android:visibility="gone" />

        <!-- Nút "Làm mới" -->
        <Button
            android:id="@+id/buttonLamMoi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Làm mới"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:elevation="2dp" />

        <!-- Nút "Lưu" -->
        <Button
            android:id="@+id/buttonLuu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Lưu kqua"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:elevation="2dp" />

        <!-- Nút "Lưu Excel" -->
        <Button
            android:id="@+id/buttonLuuExcel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lưu Excel"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:elevation="2dp" />
    </LinearLayout>

    <!-- SeekBar điều chỉnh độ bão hòa -->
    <SeekBar
        android:id="@+id/seekBarSaturation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="150"
        android:min="50"
        app:layout_constraintTop_toBottomOf="@id/linearLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="0dp" />

    <!-- TextView hiển thị giá trị của SeekBar -->
    <TextView
        android:id="@+id/textViewSaturationValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="100"
        android:textSize="10sp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/seekBarSaturation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="0dp"
        android:elevation="1dp"/>

    <!-- RadioGroup + History icon -->
    <LinearLayout
        android:id="@+id/radioGroupContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@+id/textViewSaturationValue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="1"
        android:paddingEnd="4dp">

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:elevation="0dp">

            <RadioButton
                android:id="@+id/radioButtonQI"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:buttonTint="@color/primary"
                android:text="QI"
                android:textColor="@color/black" />

            <RadioButton
                android:id="@+id/radioButtonQII"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/primary"
                android:text="QII"
                android:textColor="@color/black" />

            <RadioButton
                android:id="@+id/radioButtonQIII"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/primary"
                android:text="QIII"
                android:textColor="@color/black" />

            <RadioButton
                android:id="@+id/radioButtonQ3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/primary"
                android:text="Q3"
                android:textColor="@color/black" />
        </RadioGroup>

        <ImageView
            android:id="@+id/iconHistory"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/history"
            android:contentDescription="Lịch sử" />
    </LinearLayout>


    <TableLayout
        android:id="@+id/tableLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*"
        android:padding="0dp"
        android:background="#FFFFFF"
        android:layout_marginTop="0dp"
        app:layout_constraintTop_toBottomOf="@id/radioGroupContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:padding="3dp"
            android:background="#FFFFFF">

            <!-- Row Title -->
            <TableRow android:background="@color/gray">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/border_cell"
                    android:text="V đo"
                    android:textStyle="bold"
                    android:padding="1dp"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/border_cell"
                    android:text="Chênh lệch"
                    android:textStyle="bold"
                    android:padding="1dp"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/border_cell"
                    android:text="Sai số"
                    android:textStyle="bold"
                    android:padding="1dp"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_gravity="center"/>
            </TableRow>

            <!-- Row Old Data 2 -->
            <TableRow>
                <TextView
                    android:id="@+id/textViewLuongNuocValueOld2"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/border_cell"
                    android:text="0 Lít"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:padding="1dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/textViewChenhLechValueOld2"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/border_cell"
                    android:text="0 Lít"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:padding="1dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/textViewSaiSoValueOld2"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/border_cell"
                    android:text="0 %"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:padding="1dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_gravity="center"/>
            </TableRow>

            <!-- Row Old Data 1 -->
            <TableRow>
                <TextView
                    android:id="@+id/textViewLuongNuocValueOld1"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/border_cell"
                    android:text="0 Lít"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:padding="1dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/textViewChenhLechValueOld1"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/border_cell"
                    android:text="0 Lít"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:padding="1dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/textViewSaiSoValueOld1"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/border_cell"
                    android:text="0 %"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:padding="1dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_gravity="center"/>
            </TableRow>
            <TableRow>
                <TextView
                    android:id="@+id/textViewLuongNuocValueOld"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/border_cell"
                    android:text="0 Lít"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:padding="1dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/textViewChenhLechValueOld"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/border_cell"
                    android:text="0 Lít"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:padding="1dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/textViewSaiSoValueOld"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/border_cell"
                    android:text="0 %"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:padding="1dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_gravity="center"/>
            </TableRow>
            <!-- Row New Data -->
            <TableRow>
                <TextView
                    android:id="@+id/textViewLuongNuocValueNew"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/border_cell"
                    android:text="0 Lít"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:padding="1dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/textViewChenhLechValueNew"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/border_cell"
                    android:text="0 Lít"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:padding="1dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/textViewSaiSoValueNew"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/border_cell"
                    android:text="0 %"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:padding="1dp"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:layout_gravity="center"/>
            </TableRow>

        </TableLayout>

    </TableLayout>




</androidx.constraintlayout.widget.ConstraintLayout>
